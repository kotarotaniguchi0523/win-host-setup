amends "package://github.com/jdx/hk/releases/download/v2.6.0/hk@2.6.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.6.0/hk@2.6.0#/Builtins.pkl"

// Lint for this repository
//  - jactionlint : GitHub Actions, profile pedantic and no baseline (see .github/jactionlint.yaml)
//  - betterleaks : secrets
//  - sisakulint  : extra SAST, every rule on (nothing suppressed)
//  - pinact      : verify that `uses:` is pinned to a commit SHA (not a tag)
//  - pii / secrets / powershell : run via scripts under tools/
//
// When it runs:
//  - pre-commit: pii / secrets, plus the GitHub Actions checks when a workflow is touched
//                (jactionlint / sisakulint / pinact). Everything else waits for pre-push.
//  - pre-push  : everything (includes betterleaks / powershell)

local all = new Mapping<String, Step> {
    ["pii"] = new Step {
        glob = List("**/*")
        check = "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/depii.ps1 -Check"
    }
    ["secrets"] = new Step {
        glob = List("**/*")
        check = "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/lint/secrets.ps1"
    }
    ["jactionlint"] = Builtins.jactionlint
    ["betterleaks"] = Builtins.betterleaks
    ["sisakulint"] = new Step {
        glob = List(".github/workflows/*.yml")
        // v0.3.8 cannot parse parallel/cache-mode; jactionlint checks syntax.
        // Match tools/lint/actions.ps1 while retaining every security rule.
        check = "sisakulint -ignore syntax"
        fix = "sisakulint -ignore syntax -fix on"
    }
    // Actions must be pinned to a full commit SHA (the tag stays as a trailing comment).
    // --no-api keeps this offline: it checks the shape, Renovate updates the SHAs.
    ["pinact"] = new Step {
        glob = List(".github/workflows/*.yml")
        check = "pinact run --fix=false --no-api"
        fix = "pinact run"
    }
    ["powershell"] = new Step {
        glob = List("**/*.ps1")
        check = "pwsh -NoProfile -Command \"if (Get-Module -ListAvailable PSScriptAnalyzer) { $i = Invoke-ScriptAnalyzer -Path ./tools -Recurse -Severity Error; if ($i) { $i | Format-Table -AutoSize; exit 1 } } else { Write-Host '[i] PSScriptAnalyzer 未導入のためスキップ' }\""
    }
}

// pre-commit: light, but workflow changes are checked before the commit is made
steps = new Mapping<String, Step | Group> {
    ["pii"] = all["pii"]
    ["secrets"] = all["secrets"]
    ["jactionlint"] = all["jactionlint"]
    ["sisakulint"] = all["sisakulint"]
    ["pinact"] = all["pinact"]
}

// pre-push (everything)
hooks {
    ["pre-push"] {
        steps = all
    }
}
